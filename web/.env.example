# Postgres. Supabase: Project → Connect → "Transaction pooler" URI (port 6543).
# The Supabase ↔ Vercel integration sets POSTGRES_URL / POSTGRES_URL_NON_POOLING instead, which also work.
# Without any of these the app runs read-only on the bundled seed data.
DATABASE_URL=

# Accounts (sign in with Google or an email link). Supabase → Project Settings → API:
# "Project URL" and the "anon public" / "publishable" key. These are public by design.
# Leave empty and all account features stay hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Emails that become admin automatically when they sign in (comma-separated).
ADMIN_EMAILS=

# Backup admin login with a shared password (/admin). SESSION_SECRET must be at least 32 random characters:
#   openssl rand -base64 32
ADMIN_PASSWORD=
SESSION_SECRET=

# Lets Supabase Database Webhooks clear the site cache after edits in the Table Editor
# (header x-revalidate-secret). At least 16 random characters: openssl rand -hex 24
REVALIDATE_SECRET=

# Image uploads in the post editor. Added automatically when you connect a Vercel Blob store.
# Without it, paste image URLs instead.
BLOB_READ_WRITE_TOKEN=

# Only for `npm run bgg:import` (register at https://boardgamegeek.com/using_the_xml_api)
BGG_API_TOKEN=
